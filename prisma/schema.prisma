// ============================================================
//  CHOURMAS — Cơ sở dữ liệu
//  Thiết kế cho ngành đồ làm bánh nói chung, không chỉ khuôn
//  trung thu. Muốn bán thêm bột, dụng cụ... chỉ cần thêm
//  Category mới trong trang /admin, KHÔNG cần sửa file này.
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ------------------------------------------------------------
// DANH MỤC — hỗ trợ nhiều cấp (Khuôn bánh > Khuôn trung thu)
// ------------------------------------------------------------
model Category {
  id     String @id @default(cuid())
  slug   String @unique
  nameVi String
  nameEn String

  descVi String?
  descEn String?
  image  String?

  // Danh mục cha (null = danh mục gốc)
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive, sortOrder])
}

// ------------------------------------------------------------
// SẢN PHẨM
// ------------------------------------------------------------
model Product {
  id   String @id @default(cuid())
  sku  String @unique // Mã sản phẩm, vd: LX-001/4
  slug String @unique // Đường dẫn, vd: sen-tu-quy

  nameVi String
  nameEn String

  // Mô tả ngắn hiện dưới tên sản phẩm
  shortDescVi String?
  shortDescEn String?

  // Mô tả đầy đủ (hỗ trợ xuống dòng)
  descVi String?
  descEn String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // --- Thông số riêng của khuôn (để trống nếu là mặt hàng khác) ---
  faceCount Int? // Số mặt khuôn: 2, 3, 4, 5, 7
  diameter  String? // Đường kính, vd: "12,8 cm"
  material  String? // Chất liệu
  patterns  String? // Hoa văn từng mặt, mỗi dòng 1 mặt

  // --- Nhãn hiển thị ---
  isExclusive Boolean @default(true) // Huy hiệu "ĐỘC QUYỀN"
  isFeatured  Boolean @default(false) // Hiện ở trang chủ
  isNew       Boolean @default(false) // Huy hiệu "MỚI"
  isActive    Boolean @default(true) // Tắt = ẩn khỏi web
  inStock     Boolean @default(true) // Còn hàng / Hết hàng

  // Ghi chú hiện trong khung vàng ở trang chi tiết
  noteVi String?
  noteEn String?

  sortOrder Int @default(0)

  // SEO — để trống thì tự sinh từ tên sản phẩm
  metaTitleVi String?
  metaTitleEn String?
  metaDescVi  String?
  metaDescEn  String?

  variants ProductVariant[]
  images   ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive, sortOrder])
  @@index([isFeatured, isActive])
}

// ------------------------------------------------------------
// BIẾN THỂ — mỗi trọng lượng / combo là một biến thể
// vd: "150g" 229.000đ, "Combo 150g + 75g" 335.000đ
// ------------------------------------------------------------
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  labelVi String // "150g", "Bộ đầy đủ", "Mặt cúc mua lẻ"
  labelEn String

  price        Int // Giá bán, đơn vị VNĐ, vd: 229000
  comparePrice Int? // Giá gạch ngang (cao hơn price), để trống thì không hiện

  sku     String? // Mã riêng của biến thể, không bắt buộc
  inStock Boolean @default(true)

  // Món mua lẻ / phụ kiện, ví dụ "Mua lẻ mặt cúc" hay "Chỉ 5 mặt rời".
  // Bật lên thì giá này KHÔNG được lấy làm giá hiển thị ngoài trang danh sách,
  // tránh việc khách thấy giá rẻ rồi bấm vào mới biết đó là món bán lẻ.
  isAccessory Boolean @default(false)

  // Ghi chú nhỏ hiện cạnh biến thể, vd: "Đựng vừa khay 9"
  noteVi String?
  noteEn String?

  sortOrder Int @default(0)

  orderItems OrderItem[]

  @@index([productId, sortOrder])
}

// ------------------------------------------------------------
// ẢNH SẢN PHẨM
// ------------------------------------------------------------
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url    String // /images/products/sen-tu-quy-1.webp
  altVi  String?
  altEn  String?
  isMain Boolean @default(false)

  sortOrder Int @default(0)

  @@index([productId, sortOrder])
}

// ------------------------------------------------------------
// ĐƠN HÀNG (COD)
// ------------------------------------------------------------
model Order {
  id   String @id @default(cuid())
  code String @unique // CH2608120001

  customerName String
  phone        String
  address      String
  province     String?
  note         String?

  subtotal    Int // Tổng tiền hàng
  shippingFee Int @default(0) // Miễn phí vận chuyển
  total       Int

  status OrderStatus @default(PENDING)

  // Ghi chú nội bộ của shop, khách không thấy
  adminNote String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

enum OrderStatus {
  PENDING // Chờ xác nhận
  CONFIRMED // Đã xác nhận
  SHIPPING // Đang giao
  DELIVERED // Đã giao
  CANCELLED // Đã huỷ
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Sao chép lại tại thời điểm đặt, để sau này sửa giá không làm sai đơn cũ
  productName  String
  variantLabel String
  sku          String?
  imageUrl     String?
  unitPrice    Int
  quantity     Int
  lineTotal    Int

  @@index([orderId])
}

// ------------------------------------------------------------
// TÀI KHOẢN QUẢN TRỊ
// ------------------------------------------------------------
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// ------------------------------------------------------------
// CÀI ĐẶT WEBSITE — sửa được trong /admin, không cần đụng code
// vd: số điện thoại, link Facebook, câu slogan, nội dung trang chủ
// ------------------------------------------------------------
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// CẢM NHẬN KHÁCH HÀNG — thêm sau khi có ảnh feedback
// ------------------------------------------------------------
model Testimonial {
  id           String  @id @default(cuid())
  customerName String
  contentVi    String
  contentEn    String?
  imageUrl     String?
  rating       Int     @default(5)
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
}
