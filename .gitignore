# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Cơ sở dữ liệu và ảnh khách tải lên — không đưa lên GitHub
/data
/public/uploads

# Công cụ tạo link xem thử, tự tải về khi chạy `npm run xem-thu`
/.cong-cu

# Nhưng file mẫu thì vẫn đưa lên để người deploy biết cần điền gì
!.env.example
